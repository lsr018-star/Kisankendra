# Kisankendra environment (copy to .env.local and fill in for production)
# Development mode runs with the built-in JSON store and needs none of these.

# Production database (PostgreSQL / Supabase) connection string
DATABASE_URL=
# Supabase project URL and keys (production path, see README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign server-side sessions in production
SESSION_SECRET=
# Public app name shown in headers/emails
NEXT_PUBLIC_APP_NAME=Kisankendra
# Object storage bucket for product/ticket images (production)
STORAGE_BUCKET=kisankendra-media
# Payment gateway — Razorpay adapter (Phase 3). The gateway activates by
# configuration only: fill these in, set paymentProvider=razorpay in
# Admin -> Config, and register the webhook URL in the gateway dashboard:
#   <your-domain>/api/payments/webhook?provider=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
<redacted>
# Manual provider webhook secret (HMAC-SHA256 over the raw body). A dev
# default is used when unset — ALWAYS set a strong value in production.
MANUAL_WEBHOOK_SECRET=
