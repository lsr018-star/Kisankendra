# Kisankendra environment (copy to .env.local and fill in for production)
# Development mode runs with the built-in JSON store and needs none of these.

# Production database (PostgreSQL / Supabase) connection string
DATABASE_URL=
# Supabase project URL and keys (production path, see README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to sign server-side sessions in production
SESSION_SECRET=
# Public app name shown in headers/emails
NEXT_PUBLIC_APP_NAME=Kisankendra
# Object storage bucket for product/ticket images (production)
STORAGE_BUCKET=kisankendra-media
# Payment gateway keys (Phase 3, only after the settlement model is approved)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
